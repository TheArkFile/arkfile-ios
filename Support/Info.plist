<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ARKFILE_AD_MEASUREMENT_ENABLED</key>
	<false/>
	<key>APP_STORE_ID</key>
	<string></string>
	<key>ARKFILE_CONTENT_AUTH_TOKEN</key>
	<string></string>
	<key>ARKFILE_LITE_PRODUCT_ID</key>
	<string>app.arkfile.ios.lite</string>
	<key>ARKFILE_COMPLETE_PRODUCT_ID</key>
	<string>app.arkfile.ios.complete</string>
	<key>ARKFILE_COMPLETE_UPGRADE_PRODUCT_ID</key>
	<string>app.arkfile.ios.complete.upgrade</string>
	<key>ARKFILE_SITE_URL</key>
	<string>https://thearkfile.com</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>
	<key>CUSTOM_ABOUT_TEXT</key>
	<string>ArkFile is a portable offline library for curated knowledge packs. This iOS app is built on Kiwix Apple, CoreKiwix, and openZIM so ArkFile content can be downloaded, verified, installed, and read offline. ArkFile is an independent project and is not affiliated with or endorsed by Kiwix.</string>
	<key>CUSTOM_ABOUT_WEBSITE</key>
	<string>https://thearkfile.com</string>
	<key>CUSTOM_SOURCE_WEBSITE</key>
	<string>$(ARKFILE_SOURCE_WEBSITE)</string>
	<key>DISABLE_IMMERSIVE_READING</key>
	<true/>
	<key>FEEDBACK_EMAIL</key>
	<string>support@thearkfile.com</string>
	<key>HIDE_DONATION</key>
	<true/>
	<key>HIDE_KIWIX_CATALOG</key>
	<true/>
	<key>HIDE_RATE_APP</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>OpenZIM Content File</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.openzim.zim</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>GPX Route File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.topografix.gpx</string>
			</array>
		</dict>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>arkfile</string>
				<string>zim</string>
			</array>
		</dict>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.arkfile.essentials.content-refresh</string>
		<string>app.arkfile.saved-weather.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>ArkFile uses your location when you ask to show your position on the offline map, record a breadcrumb trail you start (including while the device is locked until you stop it), or follow your current location for Saved Weather while ArkFile is active. Weather updates send the chosen forecast point directly to the National Weather Service.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ArkFile uses your local network only when you start Local Sharing. While it is active, nearby devices on the selected Wi-Fi or Personal Hotspot can browse every readable, non-retired item in this device's ArkFile library.</string>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
				<string>public.data</string>
			</array>
			<key>UTTypeDescription</key>
			<string>GPX Route File</string>
			<key>UTTypeIdentifier</key>
			<string>com.topografix.gpx</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gpx</string>
				</array>
				<key>public.mime-type</key>
				<string>application/gpx+xml</string>
			</dict>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeDescription</key>
			<string>OpenZIM Content File</string>
			<key>UTTypeIconFiles</key>
			<array/>
			<key>UTTypeIdentifier</key>
			<string>org.openzim.zim</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>zim</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
